{
  "Id": "IamPolicyAutopilot",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::*",
        "arn:aws:s3:us-east-2:653464153304:accesspoint/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::*/*",
        "arn:aws:s3:us-east-2:653464153304:accesspoint/*/object/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3-object-lambda:ListBucket",
        "s3-object-lambda:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::*",
        "arn:aws:s3:us-east-2:653464153304:accesspoint/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}
